{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing/docs/schema.json",
  "providers": [
    {
      "tag": "机场订阅一",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "http_client": "直连下载",
      "update_interval": "12h"
    },
    {
      "tag": "机场订阅二",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "include": "香港|台湾|日本|韩国|广港|香港|HK|Hong Kong|🇭🇰|HongKong|广台|台湾|台灣|TW|Tai Wan|🇹🇼|TaiWan|Taiwan|广日|日本|JP|东京|大阪|埼玉|🇯🇵|Japan|广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea",
      "http_client": "直连下载",
      "update_interval": "12h"
    },
    {
      "tag": "机场订阅三",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "update_interval": "12h"
    }
  ],
  "dns": {
    "servers": [
      {"tag": "smartdns", "type": "udp", "server": "127.0.0.1", "server_port": 6053},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"rule_set": ["geosite-cn", "Private-Domain"], "server": "smartdns"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "fakeip",
    "strategy": "ipv4_only", 
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
  "outbounds": [
    {"tag": "➡️ 国内", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "✨ AI", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "👩‍👧‍👦 TikTok", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "🎥 流媒体", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "🌍 国外", "type": "selector", "outbounds" :["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag":"所有-自动","type":"urltest","providers":["机场订阅一","机场订阅三"],"url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"香港-自动","type":"urltest","providers":["机场订阅二"],"include":"广港|香港|HK|Hong Kong|🇭🇰|HongKong","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"台湾-自动","type":"urltest","providers":["机场订阅二"],"include":"广台|台湾|台灣|TW|Tai Wan|🇹🇼|TaiWan|Taiwan","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"日本-自动","type":"urltest","providers":["机场订阅二"],"include":"广日|日本|JP|东京|大阪|埼玉|🇯🇵|Japan","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"韩国-自动","type":"urltest","providers":["机场订阅二"],"include":"广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"新加坡-自动","type":"urltest","providers":["机场订阅二"],"include":"广新|新加坡|SG|狮城|🇸🇬|Singapore","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"美国-自动","type":"urltest","providers":["机场订阅二"],"include":"广美|US|美国|纽约|波特兰|达拉斯|俄勒|凤凰城|费利蒙|洛杉|圣何塞|圣克拉|西雅|芝加|🇺🇸|United States","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag": "直连", "type": "direct", "domain_resolver": "smartdns"},
    {"tag":"拒绝","type":"block"}
  ],
  "http_clients": [
    {"tag": "直连下载", "detour": "直连"}
  ],
  "route": {
    "rules": [
      {"rule_set":"AI","outbound":"✨ AI"},
      {"rule_set":"TikTok","outbound":"👩‍👧‍👦 TikTok"},
      {"rule_set":"YouTube","outbound":"🎥 流媒体"},
      {"rule_set":"HBO","outbound":"🎥 流媒体"},
      {"rule_set":"Disney","outbound":"🎥 流媒体"},
      {"rule_set":"Netflix","outbound":"🎥 流媒体"},
      {"rule_set":"Spotify","outbound":"🎥 流媒体"},
      {"rule_set":"Private-Domain","outbound":"➡️ 国内"},
      {"rule_set":"China-IP","outbound":"➡️ 国内"},
      {"rule_set":"Global","outbound":"🌍 国外"},
      {"outbound":"🌍 国外"}
    ],
    "rule_set": [
      {"tag":"AI","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo/geosite/category-ai-!cn.srs"},
      {"tag":"TikTok","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/tiktok.srs"},
      {"tag":"YouTube","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/youtube.srs"},
      {"tag":"HBO","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo/geosite/hbo.srs"},
      {"tag":"Disney","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo/geosite/disney.srs"},
      {"tag":"Netflix","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/netflix.srs"},
      {"tag":"Spotify","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/spotify.srs"},
      {"tag":"Global","type":"remote","format":"binary","url":"https://gh-proxy.com/raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs"},
      {"tag":"Private-Domain","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/private.srs"},
      {"tag":"geosite-cn","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/metacubex/meta-rules-dat/raw/refs/heads/sing/geo-lite/geosite/geosite-cn.srs"},
      {"tag":"China-IP","type":"remote","format":"binary","url":"https://gh-proxy.com/github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/sing/geo-lite/geoip/cn.srs"}
    ],
    "final": "🌍 国外",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "smartdns"}
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "secret": "passwd",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": false,
  },
  "log": {
    "disabled": true,
    "level": "info",
    "timestamp": true
  }
}
