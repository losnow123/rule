{
  "$schema": "https://raw.githubusercontent.com/reF1nd/sing-box/reF1nd-testing/docs/schema.json",
  "providers": [
    {
      "tag": "机场订阅一",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "http_client": "直连下载",
      "update_interval": "12h"
    },
    {
      "tag": "机场订阅二",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "include": "香港|台湾|日本|韩国|广港|香港|HK|Hong Kong|🇭🇰|HongKong|广台|台湾|台灣|TW|Tai Wan|🇹🇼|TaiWan|Taiwan|广日|日本|JP|东京|大阪|埼玉|🇯🇵|Japan|广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea",
      "http_client": "直连下载",
      "update_interval": "12h"
    },
    {
      "tag": "机场订阅三",
      "type": "remote",
      "url": "此处填入订阅链接",
      "health_check": {"enabled":true,"url":"https://www.gstatic.com/generate_204","interval":"30m","timeout":"3s"},
      "update_interval": "12h"
    }
  ],
  "dns": {
    "servers": [
      {"tag": "smartdns", "type": "udp", "server": "127.0.0.1", "server_port": 6053},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"rule_set": ["geosite-cn", "geosite-private"], "server": "smartdns"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "fakeip",
    "strategy": "ipv4_only", 
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
  "outbounds": [
    {"tag": "➡️ 国内", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "✨ AI", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "👩‍👧‍👦 TikTok", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "🎥 流媒体", "type": "selector", "outbounds": ["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag": "🌍 国外", "type": "selector", "outbounds" :["直连", "所有-自动", "香港-自动", "台湾-自动", "日本-自动", "韩国-自动", "新加坡-自动", "美国-自动", "拒绝"]},
    {"tag":"所有-自动","type":"urltest","providers":["机场订阅一","机场订阅三"],"url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"香港-自动","type":"urltest","providers":["机场订阅二"],"include":"广港|香港|HK|Hong Kong|🇭🇰|HongKong","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"台湾-自动","type":"urltest","providers":["机场订阅二"],"include":"广台|台湾|台灣|TW|Tai Wan|🇹🇼|TaiWan|Taiwan","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"日本-自动","type":"urltest","providers":["机场订阅二"],"include":"广日|日本|JP|东京|大阪|埼玉|🇯🇵|Japan","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"韩国-自动","type":"urltest","providers":["机场订阅二"],"include":"广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"新加坡-自动","type":"urltest","providers":["机场订阅二"],"include":"广新|新加坡|SG|狮城|🇸🇬|Singapore","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50},
    {"tag":"美国-自动","type":"urltest","providers":["机场订阅二"],"include":"广美|US|美国|纽约|波特兰|达拉斯|俄勒|凤凰城|费利蒙|洛杉|圣何塞|圣克拉|西雅|芝加|🇺🇸|United States","url":"https://www.gstatic.com/generate_204","interval":"10m","tolerance":50}
    {"tag": "直连", "type": "direct", "domain_resolver": "ali"}
  ],
  "http_clients": [
    {"tag": "直连下载", "detour": "直连"}
  ],
  "route": {
    "rules": [
      {"type": "logical", "mode": "and", "rules": [{"port": [53, 853], "invert": true}, {"clash_mode": "Global", "invert": true}, {"type": "logical", "mode": "or", "rules": [{"ip_is_private": true}, {"rule_set": "geoip-cn"}]}], "action": "bypass"},
      {"type": "logical", "mode": "or", "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "geoip-telegram"}], "invert": true, "action": "sniff", "sniffer": ["http", "tls", "stun", "quic", "dns"], "timeout": "100ms"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {"ip_is_private": true, "outbound": "直连"},
      {"type": "logical", "mode": "or", "rules": [{"port": 853}, {"protocol": ["stun", "quic"]}], "action": "reject", "no_drop": true},
      {"network": "icmp", "action": "resolve"},
      {"network": "icmp", "outbound": "直连"},
      {"clash_mode": "Direct", "outbound": "直连"},
      {"clash_mode": "Global", "outbound": "GLOBAL"},
      {"rule_set": "geosite-private", "outbound": "直连"},
      {"rule_set": "geosite-category-ai-!cn", "outbound": "AI"},
      {"rule_set": "geosite-youtube", "outbound": "YouTube"},
      {"rule_set": "geosite-google", "outbound": "Google"},
      {"rule_set": "geosite-github", "outbound": "Github"},
      {"rule_set": "geosite-onedrive", "outbound": "OneDrive"},
      {"rule_set": "geosite-microsoft@cn", "outbound": "直连"},
      {"rule_set": "geosite-microsoft", "outbound": "Microsoft"},
      {"rule_set": "geosite-apple@cn", "outbound": "直连"},
      {"rule_set": "geosite-apple", "outbound": "Apple"},
      {"rule_set": "geosite-telegram", "outbound": "Telegram"},
      {"rule_set": "geosite-tiktok", "outbound": "TikTok"},
      {"rule_set": "geosite-netflix", "outbound": "Netflix"},
      {"rule_set": "geosite-paypal", "outbound": "Wallet"},
      {"rule_set": "geosite-binance", "outbound": "Wallet"},
      {"rule_set": "geosite-okx", "outbound": "Wallet"},
      {"rule_set": "geosite-category-cryptocurrency", "outbound": "Wallet"},
      {"rule_set": "geosite-steam@cn", "outbound": "直连"},
      {"rule_set": "geosite-steam", "outbound": "Steam"},
      {"rule_set": "geosite-geolocation-!cn", "outbound": "默认代理"},
      {"inbound": "mixed-in", "action": "resolve","match_only": true},
      {"rule_set": "geoip-telegram", "outbound": "Telegram"},
      {"rule_set": "geoip-cn", "outbound": "直连"}
    ],
    "rule_set": [
      {"tag": ["fakeipfilter-cn", "fakeipfilter-!cn"], "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"},
      {"tag": ["geosite-category-ai-!cn", "geosite-youtube", "geosite-google", "geosite-github", "geosite-onedrive", "geosite-microsoft", "geosite-microsoft@cn","geosite-apple", "geosite-apple@cn", "geosite-telegram", "geosite-tiktok", "geosite-netflix", "geosite-paypal", "geosite-binance", "geosite-okx", "geosite-category-cryptocurrency", "geosite-steam@cn", "geosite-steam", "geosite-geolocation-!cn", "geosite-cn", "geosite-private"], "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"},
      {"tag": "geoip-telegram", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"}
    ],
    "final": "漏网之鱼",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "ali"}
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "secret": "passwd",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
